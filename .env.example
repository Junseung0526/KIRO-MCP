# ==============================================================================
# KIRO-MCP Environment Variables (EXAMPLE)
# Copy this file to `.env` and adjust values. NEVER commit the real `.env`.
# ==============================================================================

# ---- Node / Backend ----
NODE_ENV=production
# Port the backend listens on inside the container (and exposed to host)
BACKEND_PORT=3000

# ---- PostgreSQL ----
# These are used both by the `database` service (to initialize the DB)
# and by the `backend` service (to connect). Inside the compose network the
# backend reaches the DB via the service name `database`, NOT localhost.
POSTGRES_USER=kiro
POSTGRES_PASSWORD=change_me_in_real_env
POSTGRES_DB=kiro_mcp
DATABASE_HOST=database
DATABASE_PORT=5432

# Full connection string consumed by Prisma in the backend.
# Host MUST be the compose service name `database` (not localhost/127.0.0.1).
DATABASE_URL=postgresql://kiro:change_me_in_real_env@database:5432/kiro_mcp?schema=public

# Optional: expose the DB port on the host for local debugging ONLY.
# Leave commented / unset in production. Example: 5432
# HOST_DB_PORT=5432

# ---- MCP Server ----
# Base URL the MCP server uses to reach the backend over the compose network.
BACKEND_URL=http://backend:3000

# ---- Frontend ----
# The frontend (nginx) is the single public entrypoint and reverse-proxies
# /api and /health to the backend, so everything is served from one origin/port.
# Host port to expose the web UI on (default 3000).
FRONTEND_PORT=3000
# API base URL baked into the browser bundle. Leave EMPTY for same-origin
# relative calls ("/api/..."), which nginx proxies to the backend.
VITE_API_BASE_URL=

# ---- Auth (login/session) ----
# Strong random secret for signing session JWTs. Generate with:
#   openssl rand -hex 32
# NEVER commit the real value.
JWT_SECRET=replace_with_openssl_rand_hex_32
# Session lifetime in seconds (default 12h).
SESSION_TTL_SECONDS=43200
# Set the Secure cookie flag (true when served over HTTPS).
COOKIE_SECURE=true

# ---- Chat via Kiro CLI (host-side bridge) ----
# The backend calls a HOST-side bridge that runs the locally-installed,
# authenticated `kiro-cli` with the locked-down `kiro_mcp` agent (7 MCP tools).
# Reached from the container via the docker host-gateway.
KIRO_BRIDGE_URL=http://host.docker.internal:3200
# Shared token so only the backend can call the bridge. Generate with:
#   openssl rand -hex 24
KIRO_BRIDGE_TOKEN=replace_with_openssl_rand_hex_24
# Max time to wait for a chat/Kiro run (ms).
CHAT_TIMEOUT_MS=120000

# ---- Internal service token (MCP server -> backend item API) ----
# Lets the internal MCP server call the auth-protected item API on behalf of
# Kiro tool calls. Internal network only; never exposed to browsers. Generate:
#   openssl rand -hex 24
INTERNAL_API_TOKEN=replace_with_openssl_rand_hex_24

# ---- Credential encryption (Notion token at rest, etc.) ----
# 32-byte key as 64 hex chars, used for AES-256-GCM encryption of stored
# secrets (e.g. the Notion integration token saved via Settings). Generate:
#   openssl rand -hex 32
# NEVER commit the real value.
CREDENTIAL_ENCRYPTION_KEY=replace_with_openssl_rand_hex_32

# ---- Document Library (자료실) ----
# Per-file upload size limit (MB) and total storage cap (GB). Files are stored
# on a persistent Docker volume (document_storage), not in the DB.
MAX_FILE_SIZE_MB=100
MAX_STORAGE_GB=5
