// Prisma schema for KIRO-MCP backend
// Datasource: PostgreSQL 16 (reached via compose service name `database`)

generator client {
  provider      = "prisma-client-js"
  // Alpine (musl) + OpenSSL 3.x runtime target so the query/schema engines
  // load correctly inside the node:20-alpine containers.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("items")
}
