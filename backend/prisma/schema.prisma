// Prisma schema for KIRO-MCP backend
// Datasource: PostgreSQL 16 (reached via compose service name `database`)

generator client {
  provider      = "prisma-client-js"
  // Alpine (musl) + OpenSSL 3.x runtime target so the query/schema engines
  // load correctly inside the node:20-alpine containers.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Item {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([name])
  @@map("items")
}

// Single-user auth for this personal app. Exactly one row (id=1) holds the
// bcrypt password hash. No signup; password is set on first run.
model AppConfig {
  id           Int      @id @default(1)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("app_config")
}

// Minimal application log (login, chat, tool calls, errors). Never stores
// secrets (passwords, tokens, API keys) — only high-level events + metadata.
model AppLog {
  id            Int      @id @default(autoincrement())
  level         String   // info | warn | error
  event         String   // e.g. auth.login.success, chat.request, mcp.tool.call
  message       String?
  correlationId String?  @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("app_logs")
}

// Notion integration credential for this personal app. Exactly one row (id=1).
// The token is stored ENCRYPTED (AES-256-GCM); never in plaintext. Only the
// stored databaseId is ever accessed by Notion tools.
model NotionCredential {
  id             Int      @id @default(1)
  encryptedToken String   @map("encrypted_token")
  databaseId     String   @map("database_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("notion_credentials")
}

// Uploaded document (PDF/image/office/text). The file itself lives on a
// persistent volume; only metadata is stored here. Designed to be extensible
// for future text-extraction/RAG (add extractedText/embedding columns later).
model Document {
  id             String    @id @default(uuid())
  originalName   String    @map("original_name")
  storedName     String    @map("stored_name") // UUID-based filename on disk
  mimeType       String    @map("mime_type")
  ext            String // normalized lowercase extension (pdf, docx, png, ...)
  category       String // pdf | image | presentation | spreadsheet | document | text
  previewType    String    @map("preview_type") // pdf | image | text | markdown | unsupported
  sizeBytes      Int       @map("size_bytes")
  storagePath    String    @map("storage_path") // relative path within storage dir
  pageCount      Int?      @map("page_count")
  lastViewedAt   DateTime? @map("last_viewed_at")
  lastViewedPage Int?      @map("last_viewed_page") // page/slide/sheet index
  uploadedAt     DateTime  @default(now()) @map("uploaded_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([uploadedAt])
  @@index([originalName])
  @@map("documents")
}
